# font-family = JetbrainsMono Nerd Font
# font-family = psudoFont Liga Mono
font-family = Google Sans Code NF
adjust-cell-height = 3
font-size = 10

gtk-custom-css = tab-style.css

# theme = dark:catppuccin-frappe,light:dayfox
theme = Dimidium

background-opacity = 0.95

cursor-style = block
cursor-style-blink = true
adjust-cursor-thickness = 4

shell-integration=zsh
shell-integration-features = no-cursor

quick-terminal-position=left

window-width = 115
window-height = 35

# Split navigation
keybind = shift+alt+h=goto_split:left
keybind = shift+alt+j=goto_split:bottom
keybind = shift+alt+k=goto_split:top
keybind = shift+alt+l=goto_split:right
